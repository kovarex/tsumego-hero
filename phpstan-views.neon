includes:
	- tests/PHPStan/extension.neon
	- phpstan-views-baseline.neon

parameters:
	level: 5
	paths:
		- templates/
	bootstrapFiles:
		- config/phpstan-bootstrap.php
	treatPhpDocTypesAsCertain: true
	excludePaths:
		- templates/email/*
		- templates/Error/*
		- templates/layout/rss/*
		- templates/layout/xml/*
