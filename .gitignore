# CakePHP runtime #
###################
/tmp/
/logs/

# Dependencies #
#################
/vendor
/plugins

# Config (sensitive / local) #
##############################
config/database.php
config/email.php
config/core.local.php
config/define.local.php

# Build artifacts & caches #
############################
*.mo
.phpunit.result.cache
/phpunit.xml
.php-cs-fixer.cache
/.php-cs-fixer.php

# User-uploaded set cover images (keep the cache-control .htaccess)
/webroot/img/sets/*
!/webroot/img/sets/.htaccess

# Google profile pictures (created at runtime in UsersController::googlesignin)
/img/google/*.png

# phpBB forum runtime files
webroot/forums/cache
webroot/forums/store
webroot/forums/config.php
webroot/forums/vendor

# PHPUnit code coverage report (generated by `composer test-coverage`)
/webroot/coverage/
/coverage/

# IDE and editor files #
########################
.idea/
.vscode/
.local/
/nbproject
/.project
/.buildpath
/.settings/

# OS generated files #
######################
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node.js / react app #
########################
node_modules/
webroot/js/dist/
webroot/dist/
package-lock.json
.pnpm-store/
