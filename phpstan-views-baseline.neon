parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method FormHelper\:\:text\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/View/Polls/add.ctp

		-
			message: '#^Call to an undefined method Set\:\:findById\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/View/Sites/index.ctp

		-
			message: '#^Call to an undefined method SetConnection\:\:findById\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/View/Sites/index.ctp

		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 3
			path: src/View/Sites/index.ctp

		-
			message: '#^Comparison operation "\>" between int\<1, max\> and 0 is always true\.$#'
			identifier: greater.alwaysTrue
			count: 2
			path: src/View/Tsumegos/play.ctp

		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 1
			path: src/View/Tsumegos/play.ctp

		-
			message: '#^Loose comparison using \=\= between ''White '' and ''White '' will always evaluate to true\.$#'
			identifier: equal.alwaysTrue
			count: 1
			path: src/View/Tsumegos/play.ctp

		-
			message: '#^Variable \$additionalInfo in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.variable
			count: 1
			path: src/View/Tsumegos/play.ctp
