#The HTTPS front of the CI web server. The browser tests need HTTPS: the site's cookies are secure
#(Util::COOKIE_DEFAULTS), and Firefox takes a secure cookie over plain HTTP only from localhost.
https://host.docker.internal:8443, https://localhost:8443 {
    bind 0.0.0.0
    tls internal
    root * /srv

    #Every request with its status, size, duration and protocol, in caddy.log, which CI keeps when a shard fails
    log {
        output stdout
        format json
    }

    #The files of webroot/ come from Caddy, with the ETag and Last-Modified that Apache sends on the
    #site, so the browser caches them between pages. php -S sends neither, so every page downloaded
    #every script, style and picture again.
    @static {
        file
        not path *.php
    }
    handle @static {
        #WebP for a browser that accepts it, as webroot/.htaccess does
        @image path_regexp image ^(.+)\.(?i:png|jpe?g)$
        handle @image {
            header Vary Accept
            @webp {
                header Accept *image/webp*
                file {re.image.1}.webp
            }
            rewrite @webp {re.image.1}.webp
            file_server
        }
        @webpImage path_regexp \.(?i:webp)$
        header @webpImage Vary Accept
        #The change stamps, with the headers of webroot/live/.htaccess
        @stamp path /live/*
        header @stamp Cache-Control no-cache
        header @stamp X-Content-Type-Options nosniff
        header @stamp Content-Type application/json
        file_server
    }

    #The push hub of the stamps (scripts/live-hub.mjs) where one runs on port 8091, as the proxy of
    #NearlyFreeSpeech sends it there; without one the 502 sends the page to asking for the stamps itself
    @hub path /live/sse
    handle @hub {
        reverse_proxy http://host.docker.internal:8091 {
            flush_interval -1
        }
    }

    #A change stamp never bumped yet: nothing changed, as webroot/live/.htaccess answers it
    @missingStamp {
        path /live/*
        not path /live/sse
        not file
    }
    handle @missingStamp {
        respond 204
    }

    #Everything else is the site, through index.php
    handle {
        reverse_proxy http://host.docker.internal:8080 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
        }
    }
}
