# Set cover images are content-addressed (the filename is a hash of the image),
# so they never change in place and can be cached for a year.
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>

# This directory is web-writable (users upload cover images), so block
# execution of any scripts that might be uploaded here.
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .phps
RemoveType .php .phtml .php3 .php4 .php5 .phps
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
