<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

	# WebP Support: Serve WebP images when browser supports and file exists
	# Browser sends "Accept: image/webp" -> we serve .webp instead of .png/.jpg
	RewriteCond %{HTTP_ACCEPT} image/webp
	RewriteCond %{REQUEST_URI} ^(.+)\.(jpe?g|png)$ [NC]
	RewriteCond %{DOCUMENT_ROOT}%1.webp -f
	RewriteRule ^(.+)\.(jpe?g|png)$ $1.webp [T=image/webp,NC,L]

	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^(.+)$ index.php [QSA,L]
</IfModule>

# Add Vary: Accept header for proper caching of image content negotiation
<IfModule mod_headers.c>
	<FilesMatch "\.(?i:png|jpe?g|webp)$">
		Header set Vary "Accept"
	</FilesMatch>
</IfModule>

# The bundles under /dist/ get a new name whenever their content changes (Vite puts a hash of it in
# the file name), so a browser may keep each one for a year without asking again. Without a
# Cache-Control it guesses from Last-Modified, which is only minutes after a deploy.
<IfModule mod_headers.c>
	<If "%{REQUEST_URI} =~ m#^/dist/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
</IfModule>
