# While a deploy runs (deploy.sh, scripts/deploy-test-hook.cgi), tmp/maintenance.flag of the project
# exists, and every request gets the static maintenance.html as a 503, Apache alone deciding it: PHP
# is what a half-updated site breaks. Excepted are the page itself and the test site's deploy hook,
# which GitHub asks how the deploy goes. The flag is in the document root on the servers (the project
# root, rewritten into webroot/) and in its parent in DDEV (whose document root is webroot/).
# webroot/forums/.htaccess, whose rewrite rules replace these for the forum, has the same rule.
ErrorDocument 503 /maintenance.html
<IfModule mod_headers.c>
	Header always set Retry-After "60" "expr=%{REQUEST_STATUS} == 503"
	Header always set Cache-Control "no-store" "expr=%{REQUEST_STATUS} == 503"
</IfModule>

<IfModule mod_rewrite.c>
	RewriteEngine On

	RewriteCond %{DOCUMENT_ROOT}/tmp/maintenance.flag -f [OR]
	RewriteCond %{DOCUMENT_ROOT}/../tmp/maintenance.flag -f
	RewriteCond %{REQUEST_URI} !/maintenance\.html$
	RewriteCond %{REQUEST_URI} !/deploy-hook\.cgi$
	RewriteRule ^ - [R=503,L]

	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

	# WebP Support: Serve WebP images when browser supports and file exists
	# Browser sends "Accept: image/webp" -> we serve .webp instead of .png/.jpg
	RewriteCond %{HTTP_ACCEPT} image/webp
	RewriteCond %{REQUEST_URI} ^(.+)\.(jpe?g|png)$ [NC]
	RewriteCond %{DOCUMENT_ROOT}%1.webp -f
	RewriteRule ^(.+)\.(jpe?g|png)$ $1.webp [T=image/webp,NC,L]

	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^(.+)$ index.php [QSA,L]
</IfModule>

# Add Vary: Accept header for proper caching of image content negotiation
<IfModule mod_headers.c>
	<FilesMatch "\.(?i:png|jpe?g|webp)$">
		Header set Vary "Accept"
	</FilesMatch>
</IfModule>

# The bundles under /dist/ get a new name whenever their content changes (Vite puts a hash of it in
# the file name), so a browser may keep each one for a year without asking again. Without a
# Cache-Control it guesses from Last-Modified, which is only minutes after a deploy.
# On the server the project root rewrites every request into webroot/, so the address is
# /webroot/dist/... by the time this file is read.
<IfModule mod_headers.c>
	<If "%{REQUEST_URI} =~ m#^(/webroot)?/dist/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
</IfModule>
