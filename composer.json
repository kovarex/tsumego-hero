{
    "name": "cakephp/app",
    "description": "tsumego hero",
    "type": "library",
    "keywords": [
        "cakephp",
        "app"
    ],
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-exif": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ezyang/htmlpurifier": "^4.19",
        "firebase/php-jwt": "^6.11.1",
        "robmorgan/phinx": "^0.16.10",
        "cakephp/cakephp": "^5.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "php-webdriver/webdriver": "^1.15",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpcov": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/",
            "App\\Test\\PHPStan\\": "tests/PHPStan/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage/php --coverage-clover coverage/coverage.xml",
        "cs-check": "php-cs-fixer check @additional_args; E1=$?; php-cs-fixer check --config=.php-cs-fixer.templates.php @additional_args; E2=$?; test $E1 -eq 0 -a $E2 -eq 0",
        "cs-fix": "php-cs-fixer fix @additional_args; php-cs-fixer fix --config=.php-cs-fixer.templates.php @additional_args",
        "stan": "phpstan analyse @additional_args; E1=$?; phpstan analyse -c phpstan-views.neon @additional_args; E2=$?; test $E1 -eq 0 -a $E2 -eq 0",
        "migrate": "vendor/bin/phinx migrate",
        "migrate-test": "vendor/bin/phinx migrate -e test",
        "migrate-status": "vendor/bin/phinx status",
        "migrate-rollback": "vendor/bin/phinx rollback",
        "images:webp": "sh scripts/convert-to-webp.sh"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-paths": {
            "plugins/{$name}/": [
                "type:cakephp-plugin"
            ]
        }
    }
}
