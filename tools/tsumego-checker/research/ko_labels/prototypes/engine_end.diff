+// The game ended with the defender chain at p in atari. The attacker takes it; when that is a ko capture, the attacker
+// also has to connect the ko. If its connected chain is then left with at most two liberties, all shared with the target,
+// the result is a seki standoff (the ten thousand years ko shape: whoever fills a shared liberty lets the other side
+// capture), not a kill. Every other case keeps the old rule: the chain in atari is taken and the target dies.
+int endgameResolve(const State& s, int p)
+{
+  vector<int> stones;
+  chain(s, p, &stones, 2);
+  int last = -1;
+  for (int q : stones)
+    for (int k = 0; k < neighbourCount[q] && last < 0; ++k)
+      if (s.c[neighbours[q][k]] == EMPTY)
+        last = neighbours[q][k];
+  if (last < 0)
+    return KILL;
+  State t = s;
+  t.toMove = attacker;
+  t.ko = -1;
+  int captured = 0;
+  if (!play(t, last, false, &captured) || captured != 1 || t.ko < 0)
+    return KILL; // not a ko capture: the old rule
+  int koPoint = t.ko;
+  t.toMove = attacker; // the defender passes, the attacker connects the ko
+  t.ko = -1;
+  if (!play(t, koPoint, false))
+    return KILL;
+  vector<int> own;
+  int ownLiberties = chain(t, koPoint, &own, 1000);
+  if (ownLiberties > 2)
+    return KILL;
+  // the liberties of the attacker's chain must all be liberties of the target
+  static int targetLib[361], stamp = 0;
+  ++stamp;
+  for (int q : target)
+    if (t.c[q] == defender)
+    {
+      vector<int> ts;
+      chain(t, q, &ts, 1000);
+      for (int x : ts)
+        for (int k = 0; k < neighbourCount[x]; ++k)
+          if (t.c[neighbours[x][k]] == EMPTY)
+            targetLib[neighbours[x][k]] = stamp;
+    }
+  for (int q : own)
+    for (int k = 0; k < neighbourCount[q]; ++k)
+    {
+      int r = neighbours[q][k];
+      if (t.c[r] == EMPTY && targetLib[r] != stamp)
+        return KILL;
+    }
+  return NOKILL;
+}
+
+// The game ended with a defender chain in atari. Taking it is a move, and what follows can be seki (a ten thousand
+// years ko) or a ko the attacker has to approach: play it out with no threats on either side, the attacker first.
+// Inside the play-out a double pass means the attacker declined to capture, so the defender lives.
+int endgamePlayout(const State& s)
+{
+  if (inEndgame)
+    return NOKILL;
+  u64 key = s.hash ^ 0x5bd1e9955bd1e995ULL;
+  auto found = endgameCache.find(key);
+  if (found != endgameCache.end())
+    return found->second;
+  State t = s;
+  t.passes = 0;
+  t.ko = -1;
+  t.threats[BLACK] = t.threats[WHITE] = 0;
+  t.toMove = attacker;
+  bool previousAborted = aborted;
+  inEndgame = true;
+  long long before = nodes, outerBudget = budget;
+  static long long endgameBudget = getenv("ENDGAME_BUDGET") ? atoll(getenv("ENDGAME_BUDGET")) : 20000;
+  budget = min(outerBudget, nodes + endgameBudget);
+  Result r = proofSearch(t, MODE_E);
+  budget = outerBudget;
+  static long long calls = 0, spent = 0;
+  ++calls; spent += nodes - before;
+  if (getenv("ENDDEBUG") && calls == 1)
+  {
+    for (int y = 0; y < 8 && y < N; ++y)
+    {
+      for (int x = 0; x < 12 && x < N; ++x)
+      {
+        int q = y * N + x;
+        cerr << (t.c[q] == BLACK ? 'X' : t.c[q] == WHITE ? 'O' : t.c[q] == OUTSIDE ? '#' : fringe[q] ? 'f' : '.');
+      }
+      cerr << endl;
+    }
+  }
+  if (getenv("ENDDEBUG") && (calls < 5 || calls % 1000 == 0))
+    cerr << "endgame call " << calls << " result " << r.result << " nodes " << nodes - before << " total " << spent << endl;
+  inEndgame = false;
+  bool undecided = aborted || r.result == UNKNOWN;
+  aborted = previousAborted;
+  int result = undecided ? KILL : r.result; // undecided: the old static rule
+  if (!undecided)
+    endgameCache[key] = result;
+  return result;
+}
